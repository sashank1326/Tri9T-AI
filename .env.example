# Environment configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# SQLite configuration (Document metadata, hierarchy, versions, selections)
SQLITE_DB_URL=sqlite:///./data/medical_qa.db

# MongoDB configuration (AI test cases, source snapshots, staleness audit logs)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=medical_qa_system

# Gemini AI configuration for QA Test Case Generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OCR Settings (PyMuPDF fallback for rasterized / scanned pages)
OCR_ENABLED=true
TESSERACT_CMD=tesseract
